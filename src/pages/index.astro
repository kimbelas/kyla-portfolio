---
import { getCollection, getEntry } from 'astro:content'
import { getImage } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/home/Hero.astro'
import Highlights from '../components/home/Highlights.astro'
import Stats from '../components/home/Stats.astro'
import About from '../components/home/About.astro'
import Expertise from '../components/home/Expertise.astro'
import CallsSection from '../components/calls/CallsSection.astro'
import WorkPreview from '../components/work/WorkPreview.astro'
import Experience from '../components/home/Experience.astro'
import KindWords from '../components/home/KindWords.astro'
import Faq from '../components/home/Faq.astro'
import portrait from '../assets/images/profile/kyla.webp'
import { buildMeta } from '../lib/seo'
import {
  faqPageSchema,
  personSchema,
  profilePageSchema,
  websiteSchema,
} from '../lib/jsonld'

const profile = (await getEntry('profile', 'kyla'))!.data
const faqs = (await getCollection('faq'))
  .map((f) => f.data)
  .filter((f) => f.approved)
const site = Astro.site!
const image = await getImage({ src: portrait, width: 720, format: 'webp' })
const meta = buildMeta({
  description:
    'Kyla Belas is an architecture-trained executive virtual assistant and project manager in Pampanga, running construction operations, sales and marketing.',
  path: '/',
  site,
})
const jsonLd = [
  websiteSchema(site),
  profilePageSchema(site),
  personSchema(profile, site, new URL(image.src, site).href),
  ...(faqs.length > 0 ? [faqPageSchema(faqs)] : []),
]
---

<BaseLayout meta={meta} jsonLd={jsonLd}>
  <div class="mx-auto flex max-w-[1320px] flex-col gap-3 px-3 pt-5 pb-10 min-[641px]:gap-5 min-[641px]:px-6">
    <Hero />
    <Highlights />
    <Stats />
    <About />
    <Expertise />
    <CallsSection />
    <WorkPreview />
    <Experience />
    <KindWords />
    <Faq items={faqs} />
  </div>
</BaseLayout>
