---
import { getEntry } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { buildMeta } from '../lib/seo'

const profile = (await getEntry('profile', 'kyla'))!.data
const meta = buildMeta({
  description:
    'Kyla Belas is an architecture-trained executive virtual assistant and project manager for construction, sales and marketing teams.',
  path: '/',
  site: Astro.site!,
})
---

<BaseLayout meta={meta}>
  <h1 class="px-6 py-16 font-display text-4xl">
    {profile.headline.lead} <em>{profile.headline.emphasis}</em>
  </h1>
</BaseLayout>
