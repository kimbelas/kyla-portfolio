---
import BaseLayout from '../layouts/BaseLayout.astro'
import { buildMeta } from '../lib/seo'

const meta = buildMeta({
  title: 'Page not found',
  description:
    'This page could not be found. Head back to the home page to meet Kyla Belas, executive virtual assistant and project manager.',
  path: '/404.html',
  site: Astro.site!,
  noindex: true,
})
---

<BaseLayout meta={meta}>
  <section class="mx-auto max-w-[720px] px-6 py-24 text-center">
    <p class="font-script text-[56px] leading-none text-rose">404</p>
    <h1 class="mt-4 font-display text-4xl">This page could not be found</h1>
    <p class="mt-4 text-ink-soft">
      The link may be old or mistyped. The home page has everything.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex min-h-11 items-center rounded-full bg-rose px-6 font-semibold text-paper"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
