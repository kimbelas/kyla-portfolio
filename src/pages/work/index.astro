---
import { getCollection } from 'astro:content'
import WorkPage from '../../components/work/WorkPage.astro'
import { categoryCounts } from '../../lib/collections'

const items = (await getCollection('portfolio')).map((p) => p.data)
const counts = categoryCounts(items)
---

<WorkPage
  current="all"
  heading="Selected"
  emphasis="work"
  description={`Browse all ${counts.all} pieces by Kyla Belas: architecture drawings, 2A Construction and marketing designs, and business records.`}
  items={items}
  counts={counts}
/>
