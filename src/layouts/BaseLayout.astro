---
import type { Meta } from '../lib/seo'
import Seo from '../components/seo/Seo.astro'
import JsonLd from '../components/seo/JsonLd.astro'
import Nav from '../components/nav/Nav.astro'
import Footer from '../components/Footer.astro'
import { getCollection } from 'astro:content'
import { orderRecordings } from '../lib/collections'
import { serializeJsonLd } from '../lib/jsonld'
import type { TrackData } from '../scripts/player'
import '../styles/global.css'
import manropeUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url'
import bodoniUrl from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-wght-normal.woff2?url'

interface Props {
  meta: Meta
  jsonLd?: object[]
}

const { meta, jsonLd = [] } = Astro.props
const tracks: TrackData[] = orderRecordings(
  (await getCollection('recordings')).map((r) => r.data),
).map((r) => ({
  id: r.id,
  title: r.title,
  src: `/audio/${r.file}`,
  durationSec: r.durationSec,
}))
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Preload the two above-the-fold fonts so the first layout uses them (no swap relayout). */}
    <link
      rel="preload"
      href={manropeUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={bodoniUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <Seo meta={meta} />
    {jsonLd.map((data) => (
      <JsonLd data={data} />
    ))}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-ivory"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <audio id="player-audio" preload="none"></audio>
    <script
      type="application/json"
      id="track-data"
      set:html={serializeJsonLd(tracks)}
    />
    <script>
      import { initPlayerUI } from '../scripts/player-ui'

      initPlayerUI(document)
    </script>
  </body>
</html>
