---
interface Props {
  size?: number
}

const { size = 40 } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  width={size}
  height={size}
  fill="none"
  aria-hidden="true"
>
  <circle cx="24" cy="24" r="22.5" stroke="#8E4A57" stroke-width="1"></circle>
  <text
    x="24"
    y="31"
    text-anchor="middle"
    font-family="'Bodoni Moda Variable', serif"
    font-size="22"
    font-weight="500"
    fill="#8E4A57"
  >
    KB
  </text>
</svg>
