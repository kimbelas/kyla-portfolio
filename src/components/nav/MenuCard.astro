---
import Icon from '../icons/Icon.astro'

interface Props {
  items: { n: string; label: string; href: string }[]
  duration: string
  spoken: string
  ctaHref: string
  playHref: string
  links: { linkedin: string; upwork: string; onlinejobs: string }
}

const { items, duration, spoken, ctaHref, playHref, links } = Astro.props
const profiles = [
  ['LinkedIn', links.linkedin, 'flex-1'],
  ['Upwork', links.upwork, 'flex-1'],
  ['OnlineJobs.ph', links.onlinejobs, 'flex-[1.3]'],
] as const
---

<div
  data-menu-card
  class="absolute inset-x-0 top-[calc(100%+8px)] flex max-h-[calc(100dvh-96px)] flex-col gap-4 overflow-y-auto rounded-[28px] border border-line bg-paper px-5 pt-3 pb-5 shadow-[0_14px_30px_-20px_rgba(46,35,38,0.45)] min-[641px]:left-auto min-[641px]:w-[420px]"
>
  <nav aria-label="Menu">
    <ol class="m-0 list-none p-0">
      {items.map((item) => (
        <li class="border-b border-line">
          <a
            href={item.href}
            class="flex min-h-[58px] items-baseline gap-3.5 pt-3 text-ink aria-[current=true]:text-rose"
          >
            <span class="font-display text-[15px] text-rose italic">
              {item.n}
            </span>
            <span class="font-display text-[28px] leading-[1.1]">
              {item.label}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <div class="flex items-center gap-3 rounded-[20px] bg-ink px-3.5 py-3 text-ivory">
    <a
      href={playHref}
      data-play-featured
      data-mirror
      aria-label={`Play self introduction, ${spoken}`}
      class="grid size-11 flex-none place-items-center rounded-full bg-petal text-ink"
    >
      <span data-icon="play">
        <Icon name="play" size={16} />
      </span>
      <span data-icon="pause" class="hidden">
        <Icon name="pause" size={16} />
      </span>
    </a>
    <span class="flex-1">
      <span class="block text-[10px] tracking-[0.18em] text-petal uppercase">
        Start here
      </span>
      <span class="block font-display text-[18px]">Self introduction</span>
    </span>
    <span class="text-[13px] text-on-dark-muted">{duration}</span>
  </div>
  <a
    href={ctaHref}
    class="flex min-h-[52px] items-center justify-center rounded-full bg-rose px-5 text-[12px] tracking-[0.16em] text-paper uppercase"
  >
    Let’s talk
  </a>
  <div class="flex justify-between gap-1.5 text-[13px]">
    {profiles.map(([label, href, grow]) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class={`${grow} flex min-h-11 items-center justify-center rounded-full border border-line text-ink`}
      >
        {label}
      </a>
    ))}
  </div>
</div>
