---
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Item {
  id: string
  title: string
  tag: string
  alt: string
  image: ImageMetadata
}

interface Props {
  items: Item[]
  eagerCount?: number
}

const { items, eagerCount = 0 } = Astro.props
---

<div
  data-work-grid
  class="columns-2 gap-2.5 min-[641px]:[columns:3_300px] min-[641px]:gap-5"
>
  {items.map((item, i) => (
    <figure class="mb-2.5 rounded-[18px] border border-line bg-paper p-1.5 break-inside-avoid min-[641px]:mb-5 min-[641px]:rounded-3xl min-[641px]:p-2.5">
      <a
        href={item.image.src}
        data-lightbox
        class="block overflow-hidden rounded-[13px] min-[641px]:rounded-2xl"
      >
        <Picture
          src={item.image}
          alt={item.alt}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[320, 480, 720, 960]}
          sizes="(max-width: 640px) 50vw, (max-width: 1100px) 50vw, 33vw"
          loading={i < eagerCount ? 'eager' : 'lazy'}
          fetchpriority={i < eagerCount ? 'high' : undefined}
          class="block h-auto w-full"
        />
      </a>
      <figcaption class="flex flex-col gap-1 px-1 pt-2 pb-1 min-[641px]:flex-row min-[641px]:items-baseline min-[641px]:justify-between min-[641px]:gap-2 min-[641px]:px-2 min-[641px]:pt-3">
        <em class="font-display text-sm leading-tight min-[641px]:text-[19px]">
          {item.title}
        </em>
        <span class="text-[10px] tracking-[0.12em] text-muted uppercase min-[641px]:text-[11px] min-[641px]:tracking-[0.14em] min-[641px]:whitespace-nowrap">
          {item.tag}
        </span>
      </figcaption>
    </figure>
  ))}
</div>

<script>
  import { initLightbox } from '../../scripts/lightbox'

  document
    .querySelectorAll<HTMLElement>('[data-work-grid]')
    .forEach((grid) => initLightbox(grid))
</script>
