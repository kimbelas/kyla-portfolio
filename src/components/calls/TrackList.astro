---
import Icon from '../icons/Icon.astro'
import { formatDuration } from '../../lib/collections'

interface Props {
  items: { id: string; title: string; group: string; durationSec: number }[]
}

const { items } = Astro.props
const groups = [...new Set(items.map((i) => i.group))]
const chip =
  'min-h-11 cursor-pointer rounded-full bg-paper px-3.5 text-[13px] whitespace-nowrap text-ink aria-pressed:bg-ink aria-pressed:text-ivory'
---

<div class="flex gap-1.5 overflow-x-auto max-[640px]:-mx-5 max-[640px]:px-5 min-[641px]:flex-wrap">
  <button type="button" data-filter="all" aria-pressed="true" class={chip}>
    All {items.length}
  </button>
  {groups.map((g) => (
    <button type="button" data-filter={g} aria-pressed="false" class={chip}>
      {g}
    </button>
  ))}
</div>
<ol class="m-0 flex list-none flex-col p-0">
  {items.map((t, i) => (
    <li data-group={t.group} class="border-b border-line last:border-b-0">
      <button
        type="button"
        data-track-id={t.id}
        data-state="idle"
        aria-label={`Play ${t.title}`}
        class="grid min-h-[54px] w-full cursor-pointer grid-cols-[26px_1fr_auto] items-center gap-2.5 rounded-[14px] px-1 py-1.5 text-left text-ink hover:bg-blush data-[state=loading]:bg-blush data-[state=paused]:bg-blush data-[state=playing]:bg-blush min-[641px]:grid-cols-[32px_1fr_auto] min-[641px]:gap-3.5 min-[641px]:px-2.5"
      >
        <span class="font-display text-rose italic">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span class="min-w-0">
          <span class="block text-sm leading-[1.3] min-[641px]:text-[15px]">
            {t.title}
          </span>
          <span class="block text-[10px] tracking-[0.14em] text-muted uppercase min-[641px]:text-[11px]">
            {t.group}
          </span>
        </span>
        <span class="flex items-center gap-2.5 text-xs text-muted tabular-nums min-[641px]:text-[13px]">
          {formatDuration(t.durationSec)}
          <span class="grid size-8 place-items-center rounded-full bg-petal text-ink">
            <span data-icon="play">
              <Icon name="play" size={12} />
            </span>
            <span data-icon="pause" class="hidden">
              <Icon name="pause" size={12} />
            </span>
          </span>
        </span>
      </button>
    </li>
  ))}
</ol>
